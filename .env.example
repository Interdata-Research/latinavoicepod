# Copy to .env (or just export). Everything has a working default.

# --- voice ---
# LATINA_VOICE=es_f_19          # any <id>.wav in voices/
# LATINA_LANGUAGE=es
# LATINA_VOICES_DIR=./voices

# --- model ---
# LATINA_MODEL_ID=openbmb/VoxCPM2
# LATINA_CFG=2.0                # cfg is effectively free — the solver runs a
#                               # doubled batch either way — and 3.0 measured
#                               # steadier and brighter on Spanish.
# LATINA_TIMESTEPS=10           # 20 is the steadier "quality" preset, ~2x
#                               # slower. Timesteps are NOT free.
# LATINA_DENOISER=0             # only for noisy reference clips

# VoxCPM2 silently re-generates the whole utterance up to 3 times when it
# dislikes the audio-to-text ratio. Off here: measured "Sí, con él." at 9.1 s /
# RTF 8.12 with it on, 177 ms to first chunk with it off — and a retry discards
# chunks already streamed to the caller. Turn on only for offline batch work.
# LATINA_RETRY=0

# torch.compile. Off by default: on a GB10 / DGX Spark warmup never finishes
# ("Not enough SMs to use max_autotune_gemm"). On A100 / L40S / 4090 try 1 —
# it usually helps. If the first request never returns, set it back to 0.
# LATINA_OPTIMIZE=0

# --- serving ---
# LATINA_HOST=0.0.0.0
# LATINA_PORT=8000
# LATINA_WARMUP=1               # first real request shouldn't be the cold one
# Cache the encoded reference clip between requests instead of re-reading,
# resampling and re-encoding it every time. 0 restores the library's path.
# LATINA_PROMPT_CACHE=1
# LATINA_API_KEY=               # set to require Authorization: Bearer <key>

# --- speech-to-text (POST /transcribe) ---
# LATINA_ASR=1                    # 0 = no Whisper, /transcribe 503s
# LATINA_ASR_MODEL=large-v3-turbo # auto-detect model; keep multilingual
# Per-language ASR, selected by /transcribe's `language` (miniclosedai's
# "ASR: English / Spanish" picker). The language is forced, not guessed.
# LATINA_ASR_MODELS=es=large-v3,en=large-v3-turbo

# --- voice studio (web GUI at /studio/) ---
# LATINA_STUDIO=1                 # 0 disables the GUI entirely
# LATINA_STUDIO_STATIC=./static
# LATINA_STUDIO_MAX_UPLOAD_MB=20
# LATINA_STUDIO_MAX_VOICES=50
# LATINA_STUDIO_FFMPEG_TIMEOUT=20
# LATINA_STUDIO_SR=24000          # rate uploaded clips are stored at. VoxCPM2
#                                 # encodes references at 16 kHz, so this only
#                                 # needs to comfortably exceed that.

# --- not ours, but read at startup ---
# Where the ~5 GB of model weights are cached. Point it at a persistent volume
# on a cloud box or every restart re-downloads them.
# HF_HOME=/workspace/hf-cache
